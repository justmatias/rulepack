# Rules as checks (written by `rulepack init --makefile`).
.PHONY: lint-rules
lint-rules:
	rulepack lint

# Only the files changed against the base branch; warnings fail too.
# BASE_REF overrides the base ref, STAGED=1 scans the staged files.
.PHONY: lint-rules-changed
lint-rules-changed:
	rulepack lint --changed $(if $(BASE_REF),--base-ref $(BASE_REF)) $(if $(STAGED),--staged)
